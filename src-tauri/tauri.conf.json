{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MERIDIAN",
  "version": "0.3.2",
  "identifier": "com.meridian.trader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MERIDIAN",
        "width": 1320,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "backgroundColor": "#F6F5F2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
