{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MERIDIAN",
  "version": "0.4.0",
  "identifier": "com.meridian.trader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MERIDIAN",
        "width": 1320,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "backgroundColor": "#F6F5F2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMTdCNjJBN0VDM0Y1NTMKUldSVDljTitLcllYckNqRWl3ckJUc0kwWDU4Wm0rOWw5YVU5MXZubFpzeE8xNEU3U2RIRGs4SEYK",
      "endpoints": [
        "https://github.com/yixin8875/meridian/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
